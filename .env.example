# Copy to .env and replace credentials. The runtime reads uppercase names via pydantic-settings.
DATABASE_URL=postgresql+asyncpg://incidents:replace-me@localhost:5433/incidents
RABBITMQ_URL=amqp://incidents:replace-me@localhost:5672/
CACHE_URL=redis://:replace-me@localhost:6379/0
AUTH_URL=http://localhost:8001
PROJECTS_URL=http://localhost:8003
AI_BACKEND_URL=http://localhost:8000
AUTH_CLIENT_ID=incidents
AUTH_CLIENT_SECRET=replace-me
PORT=8006
BIND_HOST=0.0.0.0
